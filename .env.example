# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_USER_IDS=123456789  # comma-separated Telegram numeric user IDs

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# GitHub
GITHUB_TOKEN=your-github-pat-with-contents-write-scope
GITHUB_REPO=username/voiceblog
GITHUB_BRANCH=main

# Bot mode: "polling" for local dev, "webhook" for production
MODE=polling

# Webhook mode only (Railway injects RAILWAY_PUBLIC_DOMAIN automatically)
PORT=8080
RAILWAY_PUBLIC_DOMAIN=

# Session grouping: sliding window in seconds (default 3600 = 1 hour)
GROUPING_TIMEOUT_SECONDS=3600

# Local data directory for SQLite DB and downloaded files
DATA_DIR=./data
